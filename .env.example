# Servicio
APP_ENV=test
HTTP_PORT=9042
GIN_MODE=release
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_WRITE_TIMEOUT_SECONDS=120
QUERY_TIMEOUT_SECONDS=90
CORS_ALLOWED_ORIGINS=https://portal.acacoop.com.ar,http://localhost:4200
# Autenticacion: HS256, misma clave que el emisor de ACA (no commitear secretos)
JWT_SECRET=REEMPLAZAR_CON_SECRETO_REAL_DE_ACA
JWT_ISSUER=
JWT_AUDIENCE=
# Oracle Instant Client en el host, montado en el contenedor
ORACLE_CLIENT_HOST_PATH=/opt/oracle/instantclient
# Oracle central con DBLINKs preexistentes
ORACLE_DSN=host:1521/service_name
ORACLE_USER=usuario
ORACLE_PASSWORD=REEMPLAZAR
ORACLE_MAX_OPEN_CONNS=5
ORACLE_MAX_IDLE_CONNS=2
ORACLE_CONN_MAX_LIFETIME_MINUTES=30
# DBLINK: reemplazar los ejemplos con nombres reales. Nunca se reciben por HTTP.
ORIGIN_NEC_ENABLED=true
ORIGIN_NEC_NAME=Puerto Necochea
ORIGIN_NEC_DBLINK=DBLINK_NEC
ORIGIN_SL_ENABLED=true
ORIGIN_SL_NAME=Puerto San Lorenzo
ORIGIN_SL_DBLINK=DBLINK_SL
ORIGIN_TIM_ENABLED=true
ORIGIN_TIM_NAME=Puerto Timbues
ORIGIN_TIM_DBLINK=DBLINK_TIM
ORIGIN_SEL_ENABLED=true
ORIGIN_SEL_NAME=Puerto Selva
ORIGIN_SEL_DBLINK=DBLINK_SEL
ORIGIN_VIL_ENABLED=true
ORIGIN_VIL_NAME=Puerto Vilelas
ORIGIN_VIL_DBLINK=DBLINK_VIL
# Opcionales: deshabilitados por defecto. DBLINK vacio = tablas locales.
ORIGIN_AC_ENABLED=false
ORIGIN_AC_NAME=Acopio
ORIGIN_AC_DBLINK=
ORIGIN_CO_ENABLED=false
ORIGIN_CO_NAME=Corretaje
ORIGIN_CO_DBLINK=
# Funcion B_TB0: local en la conexion central, validar disponibilidad
ORACLE_GRAIN_NAME_FUNCTION=B_TB0
ORACLE_EMPRESA=1
